{
  "name": "walletkit",
  "version": "0.1.0",
  "description": "A React wallet kit for Web3 integrations",
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "files": ["lib"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
