  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.1.3"
  }
}
